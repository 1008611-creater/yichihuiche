	return ""


## 鍏滃簳鍙ヤ笉鑳藉崈绡囦竴寰嬶細鎸夌帺瀹跺師璇濈殑鎸囩汗閫夈€?## 鍚屼竴鎷嶉噷锛屼笉鍚岀殑璇濊惤鍒颁笉鍚岀殑鍙ュ瓙涓婏紱鍚屼竴鍙ヨ瘽鍦ㄥ洓鎷嶉噷涔熷悇涓嶇浉鍚岋紙姹犲瓙 鈮?4锛夈€?func _pick_plain(v: Variant, beat: int, player_text: String) -> String:
	if not (v is Array):
		return String(v)
