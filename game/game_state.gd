func _warmth(t: String) -> float:
	var warm := _count_hits(t, WARM_WORDS)
	var cold := _count_hits(t, COLD_WORDS)
	if warm > cold:
		return 1.0
	if cold > warm:
		return -1.0
	return 0.0


func _count_hits(t: String, keys: Array) -> int:
	var n := 0
	for k in keys:
		if t.find(String(k)) >= 0:
			n += 1
	return n


