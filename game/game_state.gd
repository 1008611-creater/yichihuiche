	if tag == "plain" and table.has("plain"):
		# 鍏滃簳锛氭病鏈夊懡涓换浣曞叧閿瘝鏃讹紝鎸夌帺瀹跺師璇濆垎娴侊紝閬垮厤鎵€鏈夎嚜鐢辫緭鍏ヨ惤鍒板悓涓€鍙ャ€?		return _pick_plain(table["plain"], beat, player_text)
	if table.has(tag):
