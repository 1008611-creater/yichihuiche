	var h := 7
	for i in t.length():
		h = (h * 131 + t.unicode_at(i)) % 1000003
	return h


## 鍐呭眰鍙拌瘝鏀寔涓ょ鍐欐硶锛氬崟鍙ワ紙鏃ф暟鎹級鎴栧洓鎷嶆暟缁勶紙鏂版暟鎹級銆?## 鏁扮粍鍐欐硶涓嬶紝鍚屼竴骞曠殑鍥涗釜鎷嶅瓙鎷垮埌鐨勬槸鍥涘彞涓嶅悓鐨勮瘽銆?func _pick_inner(v: Variant, beat: int, player_text: String) -> String:
