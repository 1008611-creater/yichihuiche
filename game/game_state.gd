func _detect_from(t: String, lexicon: Array) -> String:
	var best := ""
	var best_pos := 1 << 30
	for pair in lexicon:
		var name := String(pair[0])
		for k in pair[1]:
			var p := t.find(String(k))
			if p >= 0 and p < best_pos:
				best_pos = p
				best = name
	return best


